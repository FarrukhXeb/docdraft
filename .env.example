# Copy this file to .env.local and fill in real values.
# .env.local is gitignored - NEVER commit real secrets.

# --- Local Postgres (matches docker-compose.yml) ---
DATABASE_URL="postgresql://docdraft:docdraft@localhost:5433/docdraft?schema=public"

# --- Auth (better-auth) ---
# Generate a long random string, e.g. `openssl rand -base64 32`
BETTER_AUTH_SECRET="replace-with-a-long-random-string"
BETTER_AUTH_URL="http://localhost:3000"

# --- LLM provider ---
# Which provider implementation to use. Currently supported: "groq".
# Anthropic / Bedrock providers can be dropped in later (see README).
LLM_PROVIDER="groq"

# --- Groq (OpenAI-compatible API) ---
GROQ_API_KEY="gsk_your_key_here"
GROQ_MODEL="llama-3.3-70b-versatile"
GROQ_BASE_URL="https://api.groq.com/openai/v1"
